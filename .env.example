# Neon/Postgres
DATABASE_URL="postgresql://readonly_user:password@host/db?sslmode=require"
DIRECT_DATABASE_URL="postgresql://ingestion_user:password@host/db?sslmode=require"

# Frontend map tiles. MapTiler is optional; the app falls back to public OSM raster tiles locally.
NEXT_PUBLIC_MAPTILER_KEY=""

# Optional direct report URLs. If omitted, ingestion discovers the latest reports.
ERCOT_GIS_URL=""
CAISO_QUEUE_URL=""

# Optional notifications for GitHub Actions ingestion failures.
SLACK_WEBHOOK_URL=""
ALERT_EMAIL_TO=""
