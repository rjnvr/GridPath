# Neon/Postgres
DATABASE_URL="postgresql://readonly_user:password@host/db?sslmode=require"
DIRECT_DATABASE_URL="postgresql://ingestion_user:password@host/db?sslmode=require"

# Frontend map tiles. MapTiler is optional; the app falls back to public OSM raster tiles locally.
NEXT_PUBLIC_MAPTILER_KEY=""

# Optional direct report URLs. If omitted, ingestion discovers the latest reports.
ERCOT_GIS_URL=""
CAISO_QUEUE_URL=""

# Optional notifications for GitHub Actions ingestion failures.
SLACK_WEBHOOK_URL=""
ALERT_EMAIL_TO=""

# Auth.js (NextAuth v5)
AUTH_SECRET=""              # generate with: openssl rand -base64 32
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""           # OAuth 2.0 Client ID from Google Cloud Console
AUTH_GOOGLE_SECRET=""       # OAuth 2.0 Client Secret
AUTH_RESEND_KEY=""          # from https://resend.com/api-keys (magic-link emails)
AUTH_EMAIL_FROM="GridPath <onboarding@resend.dev>"  # use a verified domain in production
